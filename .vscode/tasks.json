    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tailwind CSS",
            "type": "shell",
            "command": "bunx tailwindcss -i ./src/rentmap-app/input.css -o ./src/rentmap-app/assets/tailwind.css -w",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}